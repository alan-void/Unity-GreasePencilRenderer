#pragma kernel Initialize
#pragma kernel CalculateRanks
#pragma kernel FindStrokeTail
#pragma kernel ResetNextPointer
#pragma kernel InitializeRanks
#pragma kernel FinalizeRanks
#pragma kernel SanitizeLinks

#include "silhouette_defines.hh"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

RWStructuredBuffer<SilhouetteStrokeEdge> _strokes; // read from silhouette pass (the same structured layout)

StructuredBuffer<int> _nextPointerSrc;
RWStructuredBuffer<int> _nextPointerDst; // per-stroke successor index (adjacency)

StructuredBuffer<uint> _rankSrc;
RWStructuredBuffer<uint> _rankDst;

uint _NumFaces;

// Convert float to a lexicographically sortable uint representation (preserves ordering including negatives)
uint FloatToSortableUint(float f)
{
    uint u = asuint(f);
    // flip sign bit so that integer ordering matches float ordering
    return (u & 0x80000000u) ? ~u : (u ^ 0x80000000u);
}

// --------

[numthreads(128,1,1)]
void Initialize(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _NumFaces) return;
    SilhouetteStrokeEdge s = _strokes[i];
    _strokes[i].minPoint = i;
    _nextPointerDst[i] = s.adj;
}

[numthreads(128,1,1)]
void ResetNextPointer(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _NumFaces) return;
    SilhouetteStrokeEdge s = _strokes[i];
    _nextPointerDst[i] = s.adj;
}

bool lessThan(float3 a, float3 b)
{
    if (a.x != b.x) return a.x < b.x;
    if (a.y != b.y) return a.y < b.y;
    return a.z < b.z;
}

bool lessThan(SilhouetteStrokeEdge a, SilhouetteStrokeEdge b)
{
    if (a.adj != b.adj)
    {
        if (a.adj == ADJ_NONE)
            return true;
        if (b.adj == ADJ_NONE)
            return false;
    }
    return lessThan(a.pos, b.pos);
}


// Use pointer jumping to propagate the minimum point as the tail in all edges
[numthreads(128,1,1)]
void FindStrokeTail(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _NumFaces) return;
    SilhouetteStrokeEdge s = _strokes[i];
    
    if (IsInvalid(s))
    {
        _nextPointerDst[i] = INVALID_UINT;
        return;
    }

    int succ = _nextPointerSrc[i];
    _nextPointerDst[i] = succ;
    if (succ >= 0)
    {
        uint succMin = _strokes[_strokes[succ].minPoint].minPoint;
        if (lessThan(_strokes[succMin], _strokes[s.minPoint]))
        {
            _strokes[i].minPoint = succMin;
        }
        _nextPointerDst[i] = _nextPointerSrc[succ];
    }
}


[numthreads(128,1,1)]
void InitializeRanks(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _NumFaces) return;
    SilhouetteStrokeEdge s = _strokes[i];
    if (IsInvalid(s))
    {
        _rankDst[i] = 0u;
        return;
    }

    bool isTail = (i == s.minPoint) || s.adj == ADJ_NONE;
    if (isTail)
    {
        _rankDst[i] = 0u;
    }
    else
    {
        float d = distance(s.pos, _strokes[s.adj].pos);
        _rankDst[i] = 1u;
        
        _strokes[s.adj].flags |= STROKE_FLAG_IS_CHILD;
    }
}

// Pointer-jumping list ranking: compute distance-to-tail (float) and hop count
[numthreads(128,1,1)]
void CalculateRanks(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _NumFaces) return;
    SilhouetteStrokeEdge si = _strokes[i];
    if (IsInvalid(si))
    {
        _nextPointerDst[i] = INVALID_UINT;
        _rankDst[i] = 0u;
        return;
    }

    if (i == si.minPoint)
    {
        if (si.adj != ADJ_NONE) _strokes[i].flags |= STROKE_FLAG_CYCLIC;
        _nextPointerDst[i] = _nextPointerSrc[i];
        _rankDst[i] = _rankSrc[i];
        return;
    }

    int succ = _nextPointerSrc[i];
    _nextPointerDst[i] = succ;

    bool succIsTail = (succ == (int)si.minPoint);
    uint succRank = succ >= 0 ? _rankSrc[succ] : 0u;
    _rankDst[i] = _rankSrc[i] + succRank;

    if (succIsTail)
    {
        if (si.adj != ADJ_NONE) _strokes[i].flags |= STROKE_FLAG_CYCLIC;
    }
    else if (succ >= 0)
    {
        _nextPointerDst[i] = _nextPointerSrc[succ];
    }
}

[numthreads(128,1,1)]
void FinalizeRanks(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _NumFaces) return;
    _strokes[i].rank = _rankSrc[i];
}

// A successor that produced no stroke element ends the chain (e.g. a neighbouring face whose contour
// segment was rejected); without this the chain would continue through stale data.
[numthreads(128,1,1)]
void SanitizeLinks(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _NumFaces) return;
    SilhouetteStrokeEdge s = _strokes[i];
    if (IsInvalid(s) || s.adj < 0) return;
    if (IsInvalid(_strokes[s.adj])) _strokes[i].adj = ADJ_NONE;
}
