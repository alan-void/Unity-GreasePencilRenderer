#pragma kernel FindSilhouetteEdge

// Define the input vertex structure
struct VertexData
{
    float3 position;
    float3 normal;
};

// world space vertex plus the per-vertex attributes interpolated onto the contour
struct ContourVertex
{
    float3 position;
    float3 normal;
    float radiusVar;
};

#include "silhouette_defines.hh"
#include "stroke_attributes.hh"
#include "lineart_camera.hh"

// Input Buffers
StructuredBuffer<VertexData> _Vertices;  // All mesh vertices
StructuredBuffer<float> _VertexRadiusVar; // baked radius variation per vertex (1 when not baked)
StructuredBuffer<int> _Indices;         // Triangle indices (3 per triangle)
StructuredBuffer<int> _AdjIndices;    // Adjacency info (3 indices per triangle, INVALID_UINT if none)

// Output Buffers
RWStructuredBuffer<SilhouetteStrokeEdge> _outStrokes;
RWStructuredBuffer<StrokePointAttributes> _outAttribs;

uint _NumFaces;              // Total number of faces (triangles)

// object->world transform and inverse-transpose for normals
float4x4 _ObjectToWorld;
float4x4 _ObjectToWorldIT;

// Blender "Skip Concave Edges": drop contour segments on folds where the surface turns away from the view
uint _SkipConcave;
float _ConcaveTolerance;

// g = N . V with the un-normalized view vector (matches Blender's Silhouette Edges • Smooth)
float ContourValue(ContourVertex v)
{
    return dot(v.normal, ViewVector(v.position));
}

// Finds the zero crossing of N.V along the edge v1 -> v2
bool TryGetZeroPoint(ContourVertex v1, ContourVertex v2, out ContourVertex zeroPoint)
{
    float g1 = ContourValue(v1);
    float g2 = ContourValue(v2);

    zeroPoint = v1;

    // If values have the same sign, no silhouette edge crosses this segment
    if ((g1 > 0.0f) == (g2 > 0.0f))
    {
        return false;
    }

    float denom = g1 - g2;
    if (abs(denom) < 1e-8f)
    {
        return false;
    }

    float t = g1 / denom;
    zeroPoint.position = lerp(v1.position, v2.position, t);
    float3 n = lerp(v1.normal, v2.normal, t);
    zeroPoint.normal = dot(n, n) > 1e-12f ? normalize(n) : v1.normal;
    zeroPoint.radiusVar = lerp(v1.radiusVar, v2.radiusVar, t);
    return true;
}

// Fold test of Blender's Silhouette Edges • Smooth: K < -tolerance marks a concave fold
bool IsConcaveFold(ContourVertex v0, ContourVertex v1, ContourVertex v2)
{
    float3 e1 = v1.position - v0.position;
    float3 e2 = v2.position - v0.position;
    float3 n = cross(e1, e2);
    float nLen = length(n);
    if (nLen < 1e-12f) return false;

    float g0 = ContourValue(v0);
    float g1 = ContourValue(v1);
    float g2 = ContourValue(v2);

    float3 v = ViewVector((v0.position + v1.position + v2.position) / 3.0f);
    float vLen = length(v);
    if (vLen < 1e-12f) return false;

    float3 gradDir = (g1 - g0) * cross(e2, n) + (g2 - g0) * cross(n, e1);
    float k = dot(gradDir, v / vLen) / (pow(nLen, 1.5f) * vLen);
    return k < -_ConcaveTolerance;
}

bool IsFrontFacing(ContourVertex v)
{
    return ContourValue(v) > 0.0f;
}

bool TryGetZeroLine(ContourVertex v0, ContourVertex v1, ContourVertex v2, uint faceIdx)
{
    int points_found = 0;
    ContourVertex zeroPoint;

    ContourVertex tmpPoints[2];
    int  tmpAdj[2];
    int   tmpEdgeIdx[2];

    // Check edge v0-v1  (edge index 0)
    if (TryGetZeroPoint(v0, v1, zeroPoint))
    {
        tmpPoints[points_found] = zeroPoint;
        tmpAdj[points_found] = _AdjIndices[faceIdx * 3 + 0];
        tmpEdgeIdx[points_found] = 0;
        points_found++;
    }

    // Check edge v1-v2  (edge index 1)
    if (TryGetZeroPoint(v1, v2, zeroPoint))
    {
        tmpPoints[points_found] = zeroPoint;
        tmpAdj[points_found] = _AdjIndices[faceIdx * 3 + 1];
        tmpEdgeIdx[points_found] = 1;
        points_found++;
    }

    // Check edge v2-v0  (edge index 2)
    if (points_found < 2 && TryGetZeroPoint(v2, v0, zeroPoint))
    {
        tmpPoints[points_found] = zeroPoint;
        tmpAdj[points_found] = _AdjIndices[faceIdx * 3 + 2];
        tmpEdgeIdx[points_found] = 2;
        points_found++;
    }
    _outStrokes[faceIdx].minPoint = points_found;

    if (points_found != 2)
    {
        return false;
    }

    if (_SkipConcave != 0 && IsConcaveFold(v0, v1, v2))
    {
        return false;
    }

    // A valid silhouette line segment crosses this triangle.
    bool flip = false;

    if (tmpEdgeIdx[0] == 0 && tmpEdgeIdx[1] == 2)
    {
        flip = true;
    }

    if (tmpEdgeIdx[0] == 0 && tmpEdgeIdx[1] == 1)
    {
        if (IsFrontFacing(v2))
        {
            flip = !flip;
        }
    }
    else if (tmpEdgeIdx[0] == 1 && tmpEdgeIdx[1] == 2)
    {
        if (IsFrontFacing(v0))
        {
            flip = !flip;
        }
    }
    else if (tmpEdgeIdx[0] == 0 && tmpEdgeIdx[1] == 2)
    {
        if (IsFrontFacing(v1))
        {
            flip = !flip;
        }
    }

    // Ensure winding is consistent with original faces
    ContourVertex p = tmpPoints[0];
    if (flip) p = tmpPoints[1];
    _outStrokes[faceIdx].pos = p.position;
    _outStrokes[faceIdx].adj = flip ? tmpAdj[1] : tmpAdj[0];
    _outStrokes[faceIdx].flags = 0;

    StrokePointAttributes attribs = DefaultStrokePointAttributes(p.normal);
    attribs.radiusVar = p.radiusVar;
    _outAttribs[faceIdx] = attribs;
    return true;
}

ContourVertex LoadWorldVertex(uint index)
{
    VertexData v = _Vertices[index];
    ContourVertex w;
    w.position = mul(_ObjectToWorld, float4(v.position, 1.0)).xyz;
    w.normal = normalize(mul((float3x3)_ObjectToWorldIT, v.normal));
    w.radiusVar = _VertexRadiusVar[index];
    return w;
}

// for each input face (triangle), a line is generated if it contains a silhouette edge
// input is triangle list with adjacency info
// output is one StrokeData per triangle (valid is set only if a silhouette line was found)
[numthreads(128, 1, 1)]
void FindSilhouetteEdge(uint3 id : SV_DispatchThreadID)
{
    uint faceIdx = id.x;

    if (faceIdx >= _NumFaces)
    {
        return;
    }
    _outStrokes[faceIdx].flags = STROKE_FLAG_IS_INVALID;

    ContourVertex w0 = LoadWorldVertex((uint)_Indices[faceIdx * 3 + 0]);
    ContourVertex w1 = LoadWorldVertex((uint)_Indices[faceIdx * 3 + 1]);
    ContourVertex w2 = LoadWorldVertex((uint)_Indices[faceIdx * 3 + 2]);

    TryGetZeroLine(w0, w1, w2, faceIdx);

    float3 fn = normalize(cross(w1.position - w0.position, w2.position - w0.position));
    _outStrokes[faceIdx].faceNormal = fn;
}
