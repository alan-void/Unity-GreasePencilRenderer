#pragma kernel SetStrokeLengthAtTail
#pragma kernel CalculateArrayOffsets
#pragma kernel MoveToDenseArray
#pragma kernel InvalidateEntries
#pragma kernel BuildDenseNextPointers
#pragma kernel OffsetDenseScreenPositions
#pragma kernel InitDenseScreenDistances
#pragma kernel DensePointerJumpDistances
#pragma kernel FinalizeDenseScreenDistances

#include "silhouette_defines.hh"
#include "stroke_attributes.hh"
#include "lineart_camera.hh"
#include "Packages/com.alanvoid.greasepencil/Runtime/Resources/GreasePencilRenderer/GreasePencil/gpencil_info.hh"
#include "Packages/com.alanvoid.greasepencil/Runtime/Resources/GreasePencilRenderer/GreasePencil/gpencil_defines.hh"
#include "Packages/com.alanvoid.greasepencil/Runtime/Resources/GreasePencilRenderer/GreasePencil/draw_grease_pencil_lib.hlsl"

RWStructuredBuffer<SilhouetteStrokeEdge> _strokes;
StructuredBuffer<StrokePointAttributes> _strokeAttribs;

// number of stroke elements (faces / corners / half-edges depending on the edge finder)
uint _NumFaces;
// capacity of the dense point arrays
uint _DenseCount;

RWStructuredBuffer<uint> numStrokesCounter;
RWStructuredBuffer<uint> numStrokePointsCounter;

RWStructuredBuffer<GreasePencilStrokeVert> _denseArray;
RWStructuredBuffer<GreasePencilColorVert> _colorArray;
RWStructuredBuffer<StrokePointAttributes> _denseAttribs;

StructuredBuffer<int> _denseNextPointerSrc;
RWStructuredBuffer<int> _denseNextPointerDst;

StructuredBuffer<float> _denseUStrokeSrc;
RWStructuredBuffer<float> _denseUStrokeDst;

float _radiusMultiplier = 1.0f;
float _LateralShiftFactor = 0.0f;
float _LateralShiftConstant = 0.0f;

#include "dense_stroke_lib.hh"

float stroke_radius_modulate(float radius)
{
    float3x3 obj3x3 = (float3x3)_GP_ObjectToWorld;
    float3 scaled = mul(obj3x3, float3(radius * 0.57735, radius * 0.57735, radius * 0.57735));
    radius = length(scaled);

    float screen_radius = radius * -(_GP_Proj[1][1]) * _ScreenParams.y;
    
    return screen_radius;
}


[numthreads(128,1,1)]
void SetStrokeLengthAtTail(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _NumFaces) return;
    SilhouetteStrokeEdge s = _strokes[idx];
    if (IsInvalid(s)) return;
    if (!IsChild(s))
    {
        _strokes[s.minPoint].totalStrokeLength = s.rank +1;
    }
}

[numthreads(128,1,1)]
void CalculateArrayOffsets(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _NumFaces) return;
    SilhouetteStrokeEdge s = _strokes[i];
    if (IsInvalid(s)) return;
    
    
    uint strokeBufferLength = _strokes[s.minPoint].totalStrokeLength + (IsCyclic(s)?1:0) + 2;
    
    if (_strokes[i].minPoint == i)
    {
        InterlockedAdd(numStrokePointsCounter[0], strokeBufferLength, _strokes[i].strokePointsOffset);
        // InterlockedAdd(numStrokesCounter[0], 1u, _strokes[i].strokeIdx);
    }
}

[numthreads(128,1,1)]
void InvalidateEntries(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _DenseCount) return;
    _denseArray[i].mat = -1;
    _denseArray[i].uv_fill = float2(-1,-1);
}
    

[numthreads(128,1,1)]
void MoveToDenseArray(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _NumFaces) return;
    SilhouetteStrokeEdge s = _strokes[i];
    if (IsInvalid(s)) return;
    SilhouetteStrokeEdge tail = _strokes[s.minPoint]; 
    int offsetInStroke = s.rank+1;
    uint globalOffset = tail.strokePointsOffset + offsetInStroke;

    GreasePencilStrokeVert gpVert;
    gpVert.pos = s.pos;
    // gpVert.pos = mul(_GP_ObjectToWorld, float4(s.pos, 1.0f)).xyz;
    gpVert.radius = _radiusMultiplier;

    gpVert.mat = 0;
    gpVert.stroke_id = tail.strokePointsOffset;
    gpVert.signed_point_id = IsCyclic(s)? -offsetInStroke: offsetInStroke;
    gpVert.packed_asp_hard_rot = pack_rotation_aspect_hardness_miter(0, 1.0f, 0.0f, 60.0f);
    gpVert.uv_fill = float2(i, 0); 
    gpVert.u_stroke = 0;
    gpVert.opacity = 1.0f;
    gpVert.ss_pos = ProjectToScreen(gpVert.pos);

    _denseArray[globalOffset] = gpVert;

    GreasePencilColorVert gpColor;
    gpColor.fcol = float4(1.0f, 1.0f, 1.0f, 1.0f);
    gpColor.vcol = float4(1.0f, 1.0f, 1.0f, 1.0f);

    _colorArray[globalOffset] = gpColor;

    StrokePointAttributes attribs = _strokeAttribs[i];
    attribs.pushRadius = gpVert.radius;
    _denseAttribs[globalOffset] = attribs;

    if (s.minPoint == i && IsCyclic(s))
    {   
        //link stoke start to the end. to get 4th point for the 1st edge
        _denseArray[tail.strokePointsOffset].stroke_id = tail.strokePointsOffset + tail.totalStrokeLength + 2;

        //add duplicate point at end, to render the last edge in the cycle
        //don't need to manually link because 4th point of the last edge is at index stroke_id+1
        uint globalOffsetEnd = tail.strokePointsOffset + tail.totalStrokeLength + 1;
        _denseArray[globalOffsetEnd] = gpVert;
        _colorArray[globalOffsetEnd] = gpColor;
        _denseAttribs[globalOffsetEnd] = attribs;
    }
}

[numthreads(128,1,1)]
void BuildDenseNextPointers(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _DenseCount) return;

    GreasePencilStrokeVert v = _denseArray[i];
    if (v.mat < 0)
    {
        _denseNextPointerDst[i] = -1;
        return;
    }

    int next = (int)(i + 1u);
    if (next >= (int)_DenseCount)
    {
        _denseNextPointerDst[i] = -1;
        return;
    }

    GreasePencilStrokeVert vn = _denseArray[next];
    if (vn.mat < 0 || vn.stroke_id != v.stroke_id)
    {
        _denseNextPointerDst[i] = -1;
        return;
    }

    _denseNextPointerDst[i] = next;
}

[numthreads(128,1,1)]
void InitDenseScreenDistances(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _DenseCount) return;

    GreasePencilStrokeVert v = _denseArray[i];
    if (v.mat < 0)
    {
        _denseUStrokeDst[i] = 0.0f;
        return;
    }

    uint succ = i + 1u;
    float d = 0.0f;

    if (succ < _DenseCount)
    {
        GreasePencilStrokeVert vn = _denseArray[succ];
        if (vn.mat >= 0 && vn.stroke_id == v.stroke_id)
        {
            d = distance(v.ss_pos, vn.ss_pos);
        }
    }

    _denseUStrokeDst[i] = d;
}

[numthreads(128,1,1)]
void DensePointerJumpDistances(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _DenseCount) return;

    GreasePencilStrokeVert v = _denseArray[i];
    if (v.mat < 0)
    {
        _denseNextPointerDst[i] = -1;
        _denseUStrokeDst[i] = 0.0f;
        return;
    }

    int succ = _denseNextPointerSrc[i];
    _denseNextPointerDst[i] = succ;
    if (succ < 0)
    {
        _denseUStrokeDst[i] = _denseUStrokeSrc[i];
        return;
    }

    _denseUStrokeDst[i] = _denseUStrokeSrc[i] + _denseUStrokeSrc[succ];

    int succ2 = _denseNextPointerSrc[succ];
    _denseNextPointerDst[i] = succ2;
}

[numthreads(128,1,1)]
void FinalizeDenseScreenDistances(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _DenseCount) return;
    _denseArray[i].u_stroke = _denseUStrokeSrc[i];
}

[numthreads(128,1,1)]
void OffsetDenseScreenPositions(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _DenseCount) return;

    GreasePencilStrokeVert strokeVert = _denseArray[i];
    if (strokeVert.mat < 0) return;

    int prev = GetPrevPointIndex((int)i, strokeVert);
    int next = GetNextPointIndex((int)i, strokeVert);

    if (prev < 0 && next < 0) return;

    float2 ss = strokeVert.ss_pos;

    float2 dir_prev = float2(0.0f, 0.0f);
    float2 dir_next = float2(0.0f, 0.0f);

    if (prev >= 0)
    {
        float2 ss_prev = _denseArray[prev].ss_pos;
        dir_prev = safe_normalize_2d(ss - ss_prev);
    }

    if (next >= 0)
    {
        float2 ss_next = _denseArray[next].ss_pos;
        dir_next = safe_normalize_2d(ss_next - ss);
    }

    float2 edge_dir = (next >= 0) ? dir_next : dir_prev;

    const float miter_limit = 0.5f;
    float2 miter_tan = safe_normalize_2d(dir_prev + dir_next);
    float miter_dot = dot(miter_tan, dir_prev);

    bool has_joint = (prev >= 0 && next >= 0);
    bool miter_break = (!has_joint) || (miter_dot < miter_limit) || (abs(miter_dot) <= 1e-6f);

    // if (!miter_break)
    // {
    //     float2 miter = perpendicular_ccw(miter_tan);
    //     offset_dir = safe_normalize_2d(miter);
    // }
    // else
    // {
    //     offset_dir = safe_normalize_2d(perpendicular_ccw(edge_dir));
    // }
    // offset_dir = float2(1,0);
    
    // no shift requested: keep the point (also avoids 0 * inf at hairpin turns)
    if (_LateralShiftFactor == 0.0f && _LateralShiftConstant == 0.0f) return;

    float2 miter = perpendicular_ccw(miter_tan);
    miter = miter / max(abs(miter_dot), 1e-3f) * (miter_dot < 0.0f ? -1.0f : 1.0f);
    
    /* The radius attribute can have negative values. Make sure that it's not negative by clamping to 0. */
    float radius = stroke_radius_modulate(strokeVert.radius);
    float clamped_radius = max(0.0f, radius);
    // float2 pixelOffset = offset_dir * _GP_ScreenParams.xy * shift_px;
    float3 worldPos = strokeVert.pos;
    float4 ndc = mul(_GP_ViewProj, float4(worldPos, 1.0f));
    
    float shift = clamped_radius/ndc.w * _LateralShiftFactor + _LateralShiftConstant;
    float2 pixelOffset = miter * shift;

    // float3 worldDelta = ScreenPixelOffsetToWorldDelta(strokeVert.pos, pixelOffset);
    float3 worldDelta;
    if (abs(ndc.w) <= 1e-8f)
    {
        worldDelta = float3(0.0f, 0.0f, 0.0f);
    }
    else
    {
        float2 basePixel = ((ndc.xy / ndc.w) * 0.5f + 0.5f) * _GP_ScreenParams.xy;
        float ndcZ = ndc.z / ndc.w;

        // float2 ndc0 = PixelToNdcXY(basePixel);
        // float2 ndc1 = PixelToNdcXY(basePixel + pixelOffset);
        float2 ndc0 = ndc.xy/ndc.w;
        float2 ndc1 = ndc0+pixelOffset/_GP_ScreenParams.xy;

        float3 world0 = UnprojectWorldFromNdc(ndc0, ndcZ);
        float3 world1 = UnprojectWorldFromNdc(ndc1, ndcZ);
        worldDelta = world1 - world0;
    }

    strokeVert.pos += worldDelta;
    // float4 clip = mul(_GP_ViewProj, float4(strokeVert.pos, 1.0f));
    // if (abs(clip.w) <= 1e-8f)
    // strokeVert.pos += float3(abs(clip.w),0,0);
    
    strokeVert.ss_pos = ProjectToScreen(strokeVert.pos);

    _denseArray[i] = strokeVert;
}
